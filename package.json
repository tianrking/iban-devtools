{
  "name": "iban-devtools",
  "version": "2.0.0",
  "private": true,
  "bin": {
    "iban-devtools": "./bin/iban-devtools.mjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "build:cloudflare": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "build:vercel": "next build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "start:vercel": "next start",
    "deploy:cloudflare": "npm run build:cloudflare && wrangler deploy",
    "deploy:vercel": "vercel --prod",
    "cli": "node --experimental-strip-types ./bin/iban-devtools.mjs",
    "geo:americas": "node ./scripts/build-americas-geo-data.mjs",
    "registry:check": "node ./scripts/check-iban-registry.mjs",
    "test": "npm run build && node --experimental-strip-types --test tests/*.test.mjs",
    "check": "npm run lint && npm run test && npm run build:vercel",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next"
  },
  "dependencies": {
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.47.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vinext": "0.0.50",
    "vite": "8.1.5",
    "wrangler": "4.114.0"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  },
  "type": "module"
}
